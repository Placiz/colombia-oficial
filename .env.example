# Solo para ejecutar en local (npm run ciclo). En GitHub se configuran en
# Settings > Secrets and variables > Actions.

# Telegram: token de @BotFather y canal donde el bot es administrador
TELEGRAM_TOKEN=
TELEGRAM_CANAL=@tu_canal

# No se notifica nada publicado hace más de N horas
MAX_ANTIGUEDAD_H=24

# X (Twitter) con la API oficial (de pago)
X_BEARER_TOKEN=

# Puentes a RSS para redes sin feed público. {usuario} se reemplaza por la
# cuenta de cada entidad. Ejemplos con RSSHub propio:
# PUENTE_X=https://tu-rsshub.ejemplo/twitter/user/{usuario}
# PUENTE_INSTAGRAM=https://tu-rsshub.ejemplo/instagram/user/{usuario}
# PUENTE_TIKTOK=https://tu-rsshub.ejemplo/tiktok/user/@{usuario}
# PUENTE_FACEBOOK=https://tu-rsshub.ejemplo/facebook/page/{usuario}
# PUENTE_THREADS=https://tu-rsshub.ejemplo/threads/{usuario}
PUENTE_X=
PUENTE_FACEBOOK=
PUENTE_INSTAGRAM=
PUENTE_TIKTOK=
PUENTE_THREADS=
